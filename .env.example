HOST=127.0.0.1
PORT=8082

OPENROUTER_API_KEY=sk-or-v1-replace-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional local gate for Claude Code / clients (Bearer or x-api-key)
PROXY_AUTH_TOKEN=local-dev-token

# Claude Code role mapping → OpenRouter :free models (tool-capable, Oct 2026 catalog)
# Opus  = heavy reasoning / long agent runs  → NVIDIA Nemotron 3 Ultra
# Sonnet = default coding / daily driver     → MiniMax M3.1 Flash
# Haiku = fast / light coding steps         → Cohere North Mini Code
MODEL_OPUS=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free
MODEL_SONNET=openrouter/minimax/minimax-m3.1-flash:free
MODEL_HAIKU=openrouter/cohere/north-mini-code:free
MODEL=openrouter/minimax/minimax-m3.1-flash:free

# Optional: only list OpenRouter models whose id contains ":free"
OPENROUTER_FREE_ONLY=true

# How often to refresh the Ollama tag cache (seconds)
OLLAMA_TAG_CACHE_SECONDS=30
