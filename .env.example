HOST=127.0.0.1
PORT=8082

OPENROUTER_API_KEY=sk-or-v1-replace-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional local gate for Claude Code / clients (Bearer or x-api-key)
PROXY_AUTH_TOKEN=local-dev-token

# Claude Code role mapping (use openrouter/... or ollama/... ids)
MODEL_OPUS=openrouter/anthropic/claude-opus-4
MODEL_SONNET=openrouter/anthropic/claude-sonnet-4
MODEL_HAIKU=ollama/qwen3-coder
MODEL=openrouter/anthropic/claude-sonnet-4

# Optional: only list OpenRouter models whose id contains ":free"
OPENROUTER_FREE_ONLY=false

# How often to refresh the Ollama tag cache (seconds)
OLLAMA_TAG_CACHE_SECONDS=30
