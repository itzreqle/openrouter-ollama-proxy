HOST=127.0.0.1
PORT=8082

OPENROUTER_API_KEY=sk-or-v1-replace-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional local gate for Claude Code / clients (Bearer or x-api-key).
# Strongly recommended if HOST is not loopback (startup warns when empty).
PROXY_AUTH_TOKEN=local-dev-token

# Write ~/.claude/settings.json modelPicker on catalog refresh (1=on, 0=off).
# Role env vars (ANTHROPIC_DEFAULT_*) are owned by the shell hook, not this writer.
OROLLAMA_WRITE_CLAUDE_SETTINGS=1

# Catalog: OpenRouter intelligence ranking (same as website order=intelligence-high-to-low).
# /v1/models lists free text models; OPENROUTER_TOOLS_ONLY only affects auto Opus/Sonnet/Haiku picks.
OPENROUTER_SORT=intelligence-high-to-low
OPENROUTER_FREE_ONLY=true
OPENROUTER_TOOLS_ONLY=true
CATALOG_CACHE_SECONDS=600

# Leave MODEL_* empty to auto-pick from the ranked catalog (openrouter-claude/... ids).
# Set any of these to pin an override (wins over auto). Legacy openrouter/ ids still route.
MODEL_OPUS=
MODEL_SONNET=
MODEL_HAIKU=
MODEL=

# How often to refresh the Ollama tag cache (seconds)
OLLAMA_TAG_CACHE_SECONDS=30
